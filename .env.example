# Local PostgreSQL from docker-compose.yml (see README "Getting started")
DATABASE_URL="postgresql://app_user:app_password@localhost:5433/growth_app"

# Better Auth — secret used to sign session tokens.
# Generate with: openssl rand -base64 32
# (must be at least 32 characters; never commit the real value)
BETTER_AUTH_SECRET=""

# Better Auth — base URL of the app
BETTER_AUTH_URL="http://localhost:3000"
