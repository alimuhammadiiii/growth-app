{
  "name": "growth-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:seed": "tsx src/db/seed.ts",
    "db:test-query": "tsx src/db/test-query.ts",
    "db:test-constraints": "tsx src/db/test-constraints.ts",
    "test": "tsx src/db/test-query.ts && tsx src/db/test-constraints.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1"
}
